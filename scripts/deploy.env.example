# Skopiuj do scripts/deploy.env (plik jest w .gitignore) i uzupełnij.
MIKRUS_USER=root
MIKRUS_HOST=srvXX.mikr.us
MIKRUS_PORT=10XXX
REMOTE_DIR=/opt/spanko/web
# Użytkownik, jako który działają usługi systemd (właściciel plików w REMOTE_DIR)

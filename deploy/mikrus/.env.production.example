# Wzór pliku /opt/spanko/web/.env.production na serwerze (chmod 600, właściciel: spanko).
# Sekrety nigdy nie trafiają do repozytorium ani do paczki wysyłanej przez deploy.sh.

OPENROUTER_API_KEY=sk-or-...

# Adres PocketBase widziany przez serwer Next.js (loopback, bez Caddy)
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# Konto superusera PocketBase (admin_settings, ai_calls, lista gospodarstw)
POCKETBASE_SUPERUSER_EMAIL=admin@twojadomena.pl
POCKETBASE_SUPERUSER_PASSWORD=zmien-na-dlugie-haslo

# Powiadomienia push o pobudce (nasłuch mikrofonem). Klucze generujesz raz:
#   npx web-push generate-vapid-keys
# Zmiana kluczy unieważnia wszystkie włączone powiadomienia (trzeba je włączyć ponownie).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@twojadomena.pl

# Tylko informacyjnie: NEXT_PUBLIC_* jest wbudowywane w czasie builda lokalnego
# (patrz .env.production.local.example), zmiana tutaj nic nie robi.
# NEXT_PUBLIC_POCKETBASE_URL=https://spanko.twojadomena.pl/pb
